    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const code = Number($json.statusCode);\nlet severity = 'LOW';\nif (code >= 500) severity = 'HIGH';\nelse if (code >= 400) severity = 'MEDIUM';\nreturn { json: { ...$json, statusCode: code, severity } };"
      },
