      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst missing = [];\nif (!b.serviceName) missing.push('serviceName');\nif (!b.endpoint) missing.push('endpoint');\nif (b.statusCode === undefined || b.statusCode === null || b.statusCode === '') missing.push('statusCode');\nif (missing.length > 0) {\n  throw new Error('Validation failed. Missing required fields: ' + missing.join(', '));\n}\nreturn {\n  json: {\n    serviceName: String(b.serviceName),\n    endpoint: String(b.endpoint),\n    statusCode: Number(b.statusCode),\n    method: b.method || b.httpMethod || null,\n    errorMessage: b.errorMessage || b.message || null,\n    requestPayload: b.requestPayload ? JSON.stringify(b.requestPayload) : null,\n  },\n};"
      },
