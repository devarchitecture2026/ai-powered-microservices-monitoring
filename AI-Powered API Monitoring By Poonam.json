    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "let raw = $json.output;\nif (raw === undefined || raw === null) raw = $json.text;\nlet text = typeof raw === 'string' ? raw : JSON.stringify(raw || {});\ntext = text.trim().replace(/^```(?:json)?/i, '').replace(/```$/,'').trim();\nlet parsed = {};\nlet ok = true;\ntry { parsed = JSON.parse(text); } catch (e) { ok = false; }\n\nconst rootCause = parsed.rootCause || parsed.root_cause || null;\nconst recommendedAction = parsed.recommendedAction || parsed.recommended_action || null;\n\nlet score = Number(parsed.confidenceScore != null ? parsed.confidenceScore : parsed.confidence_score);\nif (isNaN(score)) score = 0;\nif (score > 1) score = 1;\nif (score < 0) score = 0;\n\nlet assumptions = parsed.assumptions;\nif (Array.isArray(assumptions)) assumptions = JSON.stringify(assumptions);\nelse if (assumptions == null) assumptions = null;\nelse assumptions = String(assumptions);\n\nconst valid = ok && !!rootCause && !!recommendedAction;\n\nreturn {\n  json: {\n    id : $('Insert Failure').first().json.id,\n    root_cause: rootCause,\n    java_fix: parsed.javaFix || parsed.java_fix || null,\n    unit_test: parsed.unitTest || parsed.unit_test || null,\n    best_practice: parsed.bestPractice || parsed.best_practice || null,\n    confidence_score: score,\n    assumptions: assumptions,\n    recommended_action: recommendedAction,\n    parse_status: valid ? 'COMPLETED' : 'FAILED',\n  },\n};"
      },
